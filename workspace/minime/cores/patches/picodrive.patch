diff --git forkSrcPrefix/Makefile.libretro forkDstPrefix/Makefile.libretro
index a57a24c73b12bfe25a526c1fbc223b054b3a02fc..1a8a9054bd2577b481168824cf6cde935b3f2394 100644
--- forkSrcPrefix/Makefile.libretro
