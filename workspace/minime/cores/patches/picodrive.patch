@@ -492,6 +492,18 @@ else ifeq ($(platform), miyoo)
 	HAVE_ARMv6 = 0
 	LOW_MEMORY = 1

+# Minime
+else ifeq ($(platform), minime)
+	TARGET := $(TARGET_NAME)_libretro.so
+	ARCH = aarch64
+	CC = $(CROSS_COMPILE)gcc
+	AR = $(CROSS_COMPILE)ar
+	SHARED := -shared
+	fpic := -fPIC
+	LIBM :=
+	CFLAGS += -fomit-frame-pointer -ffast-math -march=armv8-a+crc
+	CFLAGS += -DFAMEC_NO_GOTOS
+
 # Windows MSVC 2017 all architectures
 else ifneq (,$(findstring windows_msvc2017,$(platform)))
 	NO_GCC := 1
